<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "https://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
  <context id="caisora-demo" targetRuntime="MyBatis3Simple" defaultModelType="flat">
    <plugin type="org.mybatis.generator.plugins.UnmergeableXmlMappersPlugin"/>
    <commentGenerator><property name="suppressDate" value="true"/></commentGenerator>
    <jdbcConnection driverClass="org.postgresql.Driver" connectionURL="${db.url}" userId="caisora_demo" password="${db.password}">
      <property name="nullCatalogMeansCurrent" value="true"/>
    </jdbcConnection>
    <javaModelGenerator targetPackage="br.com.caisora.dbfirst.generated.model" targetProject="generated/java"/>
    <sqlMapGenerator targetPackage="br.com.caisora.dbfirst.generated.mapper" targetProject="generated/resources"/>
    <javaClientGenerator type="XMLMAPPER" targetPackage="br.com.caisora.dbfirst.generated.mapper" targetProject="generated/java"/>
    <table schema="public" tableName="organizacao_modulos" domainObjectName="OrganizacaoModulo">
      <columnOverride column="id" javaType="java.util.UUID" jdbcType="OTHER"/>
      <columnOverride column="organizacao_id" javaType="java.util.UUID" jdbcType="OTHER"/>
    </table>
    <table schema="public" tableName="perfil_permissoes" domainObjectName="PerfilPermissao">
      <columnOverride column="id" javaType="java.util.UUID" jdbcType="OTHER"/>
      <columnOverride column="organizacao_id" javaType="java.util.UUID" jdbcType="OTHER"/>
    </table>
  </context>
</generatorConfiguration>
